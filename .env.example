# Purpose: list the keys this app reads. Copy this file to .env and fill in
# your own values. Never commit .env.

# Required: OpenAI, for the agents (gpt-4o-mini) and embeddings
OPENAI_API_KEY=

# Optional: Langfuse tracing. Leave empty to turn tracing off.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Optional: Tavily web search for current guidelines (WHO, CDC, NICE...).
# Leave empty to turn web search off; the other lookups still work.
TAVILY_API_KEY=
